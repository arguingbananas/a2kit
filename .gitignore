# Python
# (no trailing slash, so a .venv link to another worktree's environment is ignored too)
.venv
venv/
__pycache__/
*.pyc

# Your own conversions and scratch output
out/

# Assembler intermediates (the built .bin files and the boot disk ARE committed,
# so people without cc65 can use a2kit straight away)
*.o

# Temporary files from docs/make_pdfs.py
docs/.*.pdfbuild.*

# Personal Claude Code notes (see CLAUDE.md for the shared ones)
CLAUDE.local.md
